    {
      "index": 3,
      "slide_page": 0,
      "duration": 5.376,
      "cues": [
        {
          "start": 0.0,
          "end": 2.18,
          "text": "글자가 몇 개인지 세고 싶을 땐 len"
        },
        {
          "start": 2.18,
          "end": 3.78,
          "text": "함수를 쓰면 길이를 알려"
        },
        {
          "start": 3.78,
          "end": 4.4,
          "text": "줘요."
