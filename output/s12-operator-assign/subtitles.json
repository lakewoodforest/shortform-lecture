      "duration": 5.376,
      "cues": [
        {
          "start": 0.0,
          "end": 2.4,
          "text": "앞에서 봤던 등호 기호, 할당"
        },
        {
          "start": 2.4,
          "end": 4.26,
          "text": "연산자를 다시 정리해볼게요."
        }
      ]
    },
    {
      "index": 2,
      "slide_page": 0,
      "duration": 6.312,
      "cues": [
        {
          "start": 0.0,
          "end": 1.76,
          "text": "이 기호는 같다는 뜻이 아니라,"
        },
        {
          "start": 1.76,
          "end": 4.12,
          "text": "오른쪽 값을 왼쪽 변수에 저장하는"
        },
        {
          "start": 4.12,
          "end": 5.26,
          "text": "연산이에요."
        }
      ]
    },
    {
      "index": 3,
      "slide_page": 0,
      "duration": 5.616,
      "cues": [
        {
          "start": 0.0,
          "end": 2.3,
          "text": "그래서 등호의 왼쪽에는 반드시 값을"
        },
        {
          "start": 2.3,
          "end": 4.0,
          "text": "담을 수 있는 변수가 와야"
        },
        {
          "start": 4.0,
          "end": 4.6,
          "text": "해요."
        }
      ]
    },
    {
      "index": 4,
      "slide_page": 0,
      "duration": 4.968,
      "cues": [
        {
          "start": 0.0,
          "end": 2.58,
          "text": "오른쪽에는 숫자나 변수, 또는"
        },
        {
          "start": 2.58,
          "end": 3.9,
          "text": "계산식이 올 수 있죠."
        }
      ]
    },
    {
      "index": 5,
      "slide_page": 0,
      "duration": 4.56,
      "cues": [
        {
          "start": 0.0,
          "end": 1.86,
          "text": "만약 왼쪽이 변수가 아니면 오류가"
        },
        {
          "start": 1.86,
          "end": 3.46,
          "text": "나니 주의하세요."
        }
      ]
    }
  ]
