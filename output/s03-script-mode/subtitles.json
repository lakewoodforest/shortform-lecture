      "slide_page": 0,
      "duration": 5.328,
      "cues": [
        {
          "start": 0.0,
          "end": 2.02,
          "text": "그래서 명령어들을 모아 하나의 파일로"
        },
        {
          "start": 2.02,
          "end": 3.8,
          "text": "저장하는 게 스크립트 모드예요"
