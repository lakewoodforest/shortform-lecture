      "cues": [
        {
          "start": 0.0,
          "end": 2.02,
          "text": "어떤 변수가 무슨 자료형인지 궁금하면"
        },
        {
          "start": 2.02,
          "end": 4.06,
          "text": "type 함수를 써보면 돼요."
        }
      ]
    },
    {
      "index": 2,
      "slide_page": 0,
      "duration": 4.584,
      "cues": [
        {
          "start": 0.0,
          "end": 1.78,
          "text": "변수 이름을 type 괄호 안에"
        },
        {
          "start": 1.78,
          "end": 3.62,
          "text": "넣으면 자료형을 알려주죠."
        }
      ]
    },
    {
      "index": 3,
      "slide_page": 0,
      "duration": 3.984,
      "cues": [
        {
          "start": 0.0,
          "end": 2.34,
          "text": "참고로 실수는 영어로 플로트라고 표"
        },
        {
          "start": 2.34,
          "end": 3.02,
          "text": "시돼요."
        }
      ]
    },
    {
      "index": 4,
      "slide_page": 0,
      "duration": 5.304,
      "cues": [
        {
          "start": 0.0,
          "end": 2.56,
          "text": "부울형은 참 또는 거짓, 둘 중 하나만"
        },
        {
          "start": 2.56,
          "end": 4.18,
          "text": "가지는 자료형인데요."
        }
      ]
    },
    {
      "index": 5,
      "slide_page": 0,
      "duration": 6.528,
      "cues": [
        {
          "start": 0.0,
          "end": 2.1,
          "text": "나중에 조건문이나 반복문에서 어떤"
        },
        {
          "start": 2.1,
          "end": 4.12,
          "text": "조건이 맞는지 검사할 때 아주 유용하게"
        },
        {
          "start": 4.12,
          "end": 5.64,
          "text": "쓰여요."
        }
      ]
    }
  ]
