{
  "short_id": "s15-operator-division",
  "model": "small",
  "language": "ko",
  "text_source": "script",
  "scenes": [
    {
      "index": 1,
      "slide_page": 0,
      "duration": 3.216,
      "cues": [
        {
          "start": 0.0,
          "end": 2.12,
          "text": "나눗셈은 조금 주의가 필요해요."
        }
      ]
    },
    {
      "index": 2,
      "slide_page": 0,
      "duration": 5.136,
      "cues": [
        {
          "start": 0.0,
          "end": 1.7,
          "text": "파이썬에서 슬래시 한 개로 나누면"
        },
        {
          "start": 1.7,
          "end": 3.74,
          "text": "결과가 항상 소수로 나와요."
        }
      ]
    },
    {
      "index": 3,
      "slide_page": 0,
      "duration": 5.832,
      "cues": [
        {
          "start": 0.0,
          "end": 2.28,
          "text": "만약 몫만 정수로 깔끔하게 얻고 싶다면"
        },
        {
          "start": 2.28,
          "end": 4.22,
          "text": "슬래시를 두 개 붙여서 쓰면"
        },
        {
          "start": 4.22,
          "end": 4.76,
          "text": "돼요."
        }
      ]
    },
    {
      "index": 4,
      "slide_page": 0,
      "duration": 4.296,
      "cues": [
        {
          "start": 0.0,
          "end": 1.96,
          "text": "그러면 소수점 아래는 버리고 정수"
        },
        {
          "start": 1.96,
          "end": 3.3,
          "text": "부분만 남아요."
        }
      ]
    },
    {
      "index": 5,
      "slide_page": 0,
      "duration": 6.264,
      "cues": [
        {
          "start": 0.0,
          "end": 1.84,
          "text": "그리고 나눈 뒤 남는 나머지가 궁금하면"
        },
        {
          "start": 1.84,
          "end": 3.92,
          "text": "퍼센트 기호를 쓰면 나머지를"
        },
        {
          "start": 3.92,
          "end": 5.3,
          "text": "알려줘요."
        }
      ]
    }
  ]
}