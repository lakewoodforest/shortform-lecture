        {
          "start": 0.0,
          "end": 2.14,
          "text": "파이썬을 시작하는 방법은 크게 두"
        },
        {
          "start": 2.14,
          "end": 2.92,
          "text": "가지예요."
        }
      ]
    },
    {
      "index": 2,
      "slide_page": 0,
      "duration": 9.456,
      "cues": [
        {
          "start": 0.0,
          "end": 1.98,
          "text": "하나는 명령어를 한 줄씩 바로 입력해보는"
        },
        {
          "start": 1.98,
          "end": 3.66,
          "text": "대화식 모드, 다른 하나는 코드를"
        },
        {
          "start": 4.02,
          "end": 5.58,
          "text": "파일로 저장해서 한꺼번에 실행하는"
        },
        {
          "start": 5.58,
          "end": 7.46,
          "text": "스크립트 모드죠."
        }
      ]
    },
    {
      "index": 3,
      "slide_page": 0,
      "duration": 6.024,
      "cues": [
        {
          "start": 0.0,
          "end": 1.84,
          "text": "처음엔 대화식으로 가볍게 연습하고,"
        },
        {
          "start": 1.84,
          "end": 4.2,
          "text": "익숙해지면 스크립트로 넘어가면"
        },
        {
          "start": 4.2,
          "end": 4.96,
          "text": "돼요."
        }
      ]
    },
    {
      "index": 4,
      "slide_page": 0,
      "duration": 3.864,
      "cues": [
        {
          "start": 0.0,
          "end": 2.14,
          "text": "오늘은 이 두 가지를 차근차근"
        },
        {
          "start": 2.14,
          "end": 2.74,
          "text": "알아볼게요."
        }
      ]
    }
  ]
