      "slide_page": 0,
      "duration": 4.68,
      "cues": [
        {
          "start": 0.0,
          "end": 2.54,
          "text": "문자열은 큰따옴표나 작은따옴표로 감싸서"
        },
        {
          "start": 2.54,
          "end": 3.66,
          "text": "만들어요."
