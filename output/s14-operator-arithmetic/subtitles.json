      "slide_page": 0,
      "duration": 4.56,
      "cues": [
        {
          "start": 0.0,
          "end": 2.08,
          "text": "더하기는 플러스, 빼기는 마이너스"
        },
        {
          "start": 2.08,
          "end": 3.6,
          "text": "기호를 써요."
