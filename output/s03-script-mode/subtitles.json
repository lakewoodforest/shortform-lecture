      "slide_page": 0,
      "duration": 4.8,
      "cues": [
        {
          "start": 0.0,
          "end": 2.24,
          "text": "이렇게 저장한 코드 파일은 이름 뒤에"
        },
        {
          "start": 2.24,
          "end": 3.78,
          "text": "점 파이가 붙어요."
